# Bu dosyayı .env olarak kopyalayıp değerleri değiştirin: cp .env.example .env

# PostgreSQL
POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=degistirin-guclu-bir-sifre

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTURUM_GIZLI_ANAHTAR=degistirin-uzun-rastgele-bir-deger

# İlk çalıştırmada (hiç editör yokken) oluşturulacak yönetici hesabı
ILK_ADMIN_KULLANICI=admin
ILK_ADMIN_SIFRE=degistirin-ilk-admin-sifresi

# Site HTTPS arkasında yayınlanıyorsa true yapın
GUVENLI_CEREZ=false

# Bilgisayarda açılacak port (http://localhost:3000)
STORE_PORT=3000
