# Kopyala: cp site/.env.example site/.env   ve değerleri doldur. .env ASLA git'e girmez.

# Alan adı. Yerel denemede localhost bırak; sunucuda gerçek alan adını yaz (DNS A kaydı sunucuya baksın).
SITE_DOMAIN=localhost

POSTGRES_DB=ytfilter
POSTGRES_USER=ytfilter
# Yalnızca harf ve rakam kullan (özel karakterler bağlantı adresini bozar). En az 24 karakter, rastgele.
POSTGRES_PASSWORD=BURAYA_UZUN_RASTGELE_SIFRE

# --- Site uygulaması ---
# Yerelde PGlite kullanmak için SITE_DB=pglite. Üretimde DATABASE_URL docker compose tarafından kurulur.
SITE_DB=pglite
PGLITE_DIR=.pglite

# Kamusal origin. Caddy/proxy arkasında origin kontrolü için zorunlu; üretimde https://alan-adin yaz.
SITE_ORIGIN=http://localhost:3000

# IP özeti (HMAC-SHA256) ve ziyaretçi çerezi imzası için uzun, rastgele anahtar.
# Üretimde mutlaka değiştir. Anahtar değişirse eski IP özetleri ve imzalı
# ziyaretçi çerezleri geçersiz olur; ziyaretçiler yeni kimlikle devam eder.
IP_HASH_SECRET=BURAYA_UZUN_RASTGELE_ANAHTAR

# Hız limitleri (opsiyonel; aşağıdaki değerler varsayılandır).
# Pozitif tam sayı yazın. Geçersiz değerler uyarı verip varsayılana döner.
OY_LIMITI_DAKIKA=120
OY_LIMITI_GUN=2000
TALEP_LIMITI_SAAT=5
GIRIS_LIMITI_15DK=10
PANEL_YAZMA_LIMITI_DAKIKA=120

# YouTube Data API anahtarı (opsiyonel; kota takibi ve metadata için).
YOUTUBE_API_KEY=

# İlk admin hesabı (npm run ilk-admin için).
ILK_ADMIN_EPOSTA=
ILK_ADMIN_PAROLA=
