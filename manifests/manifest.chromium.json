{
  "manifest_version": 3,
  "name": "YouTube Filtreleyici",
  "version": "1.0",
  "minimum_chrome_version": "111",
  "description": "YouTube'u konu ve etiketlere göre filtreler; kanal/video istisnaları, kararsız içerik seçimi ve PIN kilidi.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["core/taxonomy.js", "core/decision.js", "core/migrate.js", "core/db.js", "core/engine.js", "content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["inject_helper.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject_helper.js", "inject.css", "data/db.json"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "Filtre Ayarları",
    "default_popup": "options.html"
  }
}
