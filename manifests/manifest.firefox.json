{
  "manifest_version": 3,
  "name": "YouTube Filtreleyici",
  "version": "2.0.0",
  "description": "YouTube'u konu ve etiketlere göre filtreler; kanal/video istisnaları, kararsız içerik seçimi ve PIN kilidi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-filter@servifiltre",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["core/taxonomy.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["core/taxonomy.js", "core/pin.js", "core/kilit.js", "core/decision.js", "core/migrate.js", "core/db.js", "core/engine.js", "content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["inject_helper.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject_helper.js", "inject.css", "data/db.json"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "Filtre Ayarları",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
