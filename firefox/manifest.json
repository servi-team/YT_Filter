{
  "manifest_version": 3,
  "name": "YouTube Filtreleyici",
  "version": "1.0",
  "description": "Özel kanal istisnaları, video etiketleme, PIN koruması ve otomatik senkronizasyon içeren gelişmiş filtreleyici.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-filter@servifiltre",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.google.com.tr/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*", 
        "*://*.google.com/*", 
        "*://*.google.com.tr/*"
      ],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["inject_helper.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject_helper.js", "inject.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "Filtre Ayarları",
    "default_popup": "options.html"
  }
}
